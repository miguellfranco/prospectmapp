generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  passwordHash         String?
  plan                 String    @default("free") // mensal | trimestral | anual | free
  planStatus           String    @default("trial") // active | inactive | trial
  planExpiresAt        DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  referralCode         String    @unique
  referredBy           String?
  isAdmin              Boolean   @default(false) // acesso ao Super Admin (além do MASTER_EMAIL)
  leadsUsedToday       Int       @default(0)
  leadsResetDate       DateTime  @default(now())
  trackingPixelId      String?   @unique
  whatsappNumber       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  leads                Lead[]
  messages             Message[]
  sales                Sale[]
  affiliatesAsReferrer Affiliate[] @relation("Referrer")
  affiliatesAsReferred Affiliate[] @relation("Referred")
  pixelPings           PixelPing[]
  pixPayments          PixPayment[]
  paymentIntegrations  PaymentIntegration[]
  structures           Structure[]
  infoproductSales     InfoproductSale[]

  @@index([referralCode])
  @@index([email])
}

model PixPayment {
  id                String    @id @default(cuid())
  abacatePayId      String    @unique // AbacatePay charge/checkout id ("transparents" or "checkouts")
  method            String    @default("PIX") // PIX | CARD
  email             String
  phone             String
  plan              String    // mensal | trimestral | anual
  amount            Int       // in cents, matches AbacatePay's data.amount
  status            String    @default("pending") // pending | paid | expired | cancelled | failed
  brCode            String?   @db.Text // PIX copia-e-cola code (PIX only)
  brCodeBase64      String?   @db.Text // PIX QR code image (data URI) (PIX only)
  checkoutUrl       String?   @db.Text // AbacatePay hosted page URL (CARD only)
  expiresAt         DateTime
  paidAt            DateTime?
  accessGrantedAt   DateTime? // set once the account was created/renewed + email sent (idempotency guard)
  userId            String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
}

model Lead {
  id              String    @id @default(cuid())
  userId          String
  businessName    String
  phone           String?
  city            String?
  niche           String?
  rating          Float?
  reviewCount     Int?
  hasWebsite      Boolean   @default(false)
  yearsWithoutSite Int?
  score           Int       @default(0) // 0-10
  tier            String    @default("cold") // hot | warm | cold
  status          String    @default("novo") // novo | mensagem_gerada | enviado | respondeu | venda_fechada | ignorado
  apifyPlaceId    String?
  inTopGoogle     Boolean   @default(false)
  gmbOptimized    Boolean   @default(false)
  instagramUrl    String?
  whatsappUrl     String?
  viewed          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        Message[]
  sales           Sale[]

  @@index([userId])
  @@index([userId, createdAt])
}

model Message {
  id              String    @id @default(cuid())
  userId          String
  leadId          String
  messageText     String
  generatedAt     DateTime  @default(now())
  sentAt          DateTime?
  whatsappOpenedAt DateTime?

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([leadId])
}

model Sale {
  id          String    @id @default(cuid())
  userId      String
  leadId      String?
  niche       String?
  city        String?
  clientName  String?
  saleValue   Float?
  description String?
  isPublic    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model Affiliate {
  id                 String   @id @default(cuid())
  referrerId         String
  referredUserId     String
  planType           String?  // mensal | vitalicio
  firstCommission    Float    @default(0)
  recurringCommission Float   @default(0)
  status             String   @default("active") // active | cancelled
  totalEarned        Float    @default(0)
  createdAt          DateTime @default(now())

  referrer           User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred           User     @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)
  commissions        Commission[]

  @@index([referrerId])
}

model Commission {
  id              String   @id @default(cuid())
  affiliateId     String
  amount          Float
  type            String   // first | recurring
  stripePaymentId String?
  status          String   @default("pending") // pending | paid
  createdAt       DateTime @default(now())

  affiliate       Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
}

model ScrapedBusiness {
  id              String    @id @default(cuid())
  niche           String
  city            String
  businessName    String
  phone           String?
  address         String?
  rating          Float?
  reviewCount     Int?
  hasWebsite      Boolean   @default(false)
  instagramUrl    String?
  whatsappUrl     String?
  apifyPlaceId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([niche, city, businessName])
  @@index([niche, city])
}

// ============================================================
// EbookAI — gerador de infoprodutos com IA (pivot 2026-07)
// ============================================================

model PaymentIntegration {
  id             String    @id @default(cuid())
  userId         String
  provider       String    // kiwify | hotmart | outro
  label          String?
  credentialsEnc String    @db.Text // JSON criptografado (AES-256-GCM)
  status         String    @default("desconectado") // conectado | erro | desconectado
  statusMessage  String?
  lastCheckedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products       EbookProduct[]
  infoSales      InfoproductSale[]

  @@index([userId])
}

// Uma "Estrutura" = um funil de infoproduto completo (wizard de 4 passos)
model Structure {
  id        String   @id @default(cuid())
  userId    String
  niche     String
  subNiche  String?
  title     String   // dor principal / headline escolhida
  status    String   @default("rascunho") // rascunho | conteudo_gerado | precificado | landing_gerada | concluida
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          EbookProduct?
  landingPage      LandingPage?
  outreachGroups   OutreachGroup[]
  outreachMessages OutreachMessage[]

  @@index([userId])
  @@index([userId, createdAt])
}

model EbookProduct {
  id                   String   @id @default(cuid())
  structureId          String   @unique
  name                 String
  content              String?  @db.Text // versão texto/markdown do e-book (referência/edição)
  designJson           String?  @db.Text // estrutura página-por-página do livro designado (JSON)
  accentColor          String   @default("#7c3aed") // cor de destaque do e-book (capa, capítulos, cards)
  price                Float?
  paymentIntegrationId String?
  externalProductId    String?
  checkoutUrl          String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  structure          Structure           @relation(fields: [structureId], references: [id], onDelete: Cascade)
  paymentIntegration PaymentIntegration? @relation(fields: [paymentIntegrationId], references: [id], onDelete: SetNull)
  infoSales          InfoproductSale[]
}

model LandingPage {
  id             String    @id @default(cuid())
  structureId    String    @unique
  slug           String    @unique
  primaryColor   String    @default("#7c3aed")
  secondaryColor String    @default("#05050b")
  headline       String
  subheadline    String?
  copyJson       String    @db.Text // seções geradas pela IA (benefícios, por que funciona, FAQ, CTA)
  priceDisplay   String?
  publishedAt    DateTime? // legado: páginas antigas hospedadas em /p/[slug]; novas ficam null
  userHostedUrl  String?   @db.Text // URL da página publicada pelo usuário (Netlify/Vercel dele)
  netlifySiteId  String?   // site criado via integração Netlify (para republicar no mesmo endereço)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  structure Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([slug])
}

model OutreachGroup {
  id          String   @id @default(cuid())
  structureId String
  platform    String   // facebook | whatsapp
  groupName   String
  groupUrl    String   @db.Text
  memberCount Int?
  country     String   @default("BR")
  createdAt   DateTime @default(now())

  structure Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([structureId])
}

model OutreachMessage {
  id            String   @id @default(cuid())
  structureId   String
  generatedText String   @db.Text
  createdAt     DateTime @default(now())

  structure Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([structureId])
}

// Vendas dos infoprodutos dos usuários, recebidas via webhook dos gateways
model InfoproductSale {
  id                   String   @id @default(cuid())
  userId               String
  productId            String?
  paymentIntegrationId String?
  amount               Float    // em reais
  gateway              String?  // kiwify | hotmart | outro
  gatewayTransactionId String?  @unique
  buyerEmail           String?
  paidAt               DateTime @default(now())
  createdAt            DateTime @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  product            EbookProduct?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  paymentIntegration PaymentIntegration? @relation(fields: [paymentIntegrationId], references: [id], onDelete: SetNull)

  @@index([userId, paidAt])
}

model PixelPing {
  id        String   @id @default(cuid())
  userId    String
  domain    String
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now()) @updatedAt
  pingCount Int      @default(1)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
  @@index([userId])
}

